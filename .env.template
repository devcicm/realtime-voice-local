# Copia este archivo a .env y ajusta los valores.
# Las variables que no definas toman el default de server/shared/config.py.

# --- Red -------------------------------------------------------------------
# Por defecto todo escucha solo en localhost. Para exponer en la LAN:
#   BIND_HOST=0.0.0.0
#   CORS_ORIGINS=http://192.168.1.50:5500   (lista separada por comas, o *)
# Nota: start.cmd / _run_*.cmd leen BIND_HOST del entorno, no de este archivo.
BIND_HOST=127.0.0.1
CORS_ORIGINS=

# --- Autenticación (obligatoria si expones el servidor TTS fuera de tu PC) ---
# Claves separadas por comas. Vacío = sin autenticación (uso local).
# Con claves, todo /tts, /ws/tts, /ws/voice, /llm/*, /voices... exige
#   Authorization: Bearer <clave>   (o X-API-Key, o ?api_key= en WebSocket)
# /health queda libre. Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- TTS -------------------------------------------------------------------
TTS_BACKEND=piper          # piper | kokoro | xtts | auto
PIPER_VOICES_DIR=          # vacio = ~/.local/share/piper/voices
VOICE_NAME=ef_dora         # voz default (Kokoro)
SPEED=1.2
LANG_CODE=e                # e = espanol

# --- LLM (LM Studio u Ollama) ----------------------------------------------
LM_STUDIO_URL=http://127.0.0.1:12344/v1   # 127.0.0.1, no localhost: en Windows ::1 cuesta ~2 s por conexion
OLLAMA_URL=http://localhost:11434/api/chat
LLM_MODEL=google/gemma-4-e2b
DEFAULT_SYSTEM_PROMPT=Eres un asistente amigable. Responde en español de forma natural y breve.
LLM_TEMPERATURE=0.7
LLM_RETRY_DELAY=0.5
MAX_RETRIES=3

# --- STT clasico (servidor :8100, modo local-chain del cliente) --------------
STT_MODEL=parakeet             # default si el cliente no pide modelo: parakeet | base | small ...
STT_PARAKEET_QUANT=int8

# --- Realtime voice (/ws/voice) ---------------------------------------------
REALTIME_STT_ENGINE=parakeet   # parakeet (Parakeet TDT 0.6B v3, ONNX) | whisper
REALTIME_STT_QUANT=int8        # parakeet: int8 | fp32
REALTIME_STT_THREADS=0         # 0 = automatico
# Solo con REALTIME_STT_ENGINE=whisper:
REALTIME_STT_MODEL=base        # tiny confunde 1 de cada 4 palabras en espanol
REALTIME_STT_DEVICE=cpu        # cuda con GPU
REALTIME_STT_COMPUTE=int8      # float16 con GPU
REALTIME_STT_BEAM=5
REALTIME_LLM_REASONING=none    # reasoning_effort para LM Studio ("" = no enviar)
REALTIME_PRELOAD=1             # calentar STT/Piper/VAD al arrancar

# --- Opcional --------------------------------------------------------------
# Solo necesario para pyannote (VAD) o repos privados de HuggingFace.
HUGGINGFACE_TOKEN=
